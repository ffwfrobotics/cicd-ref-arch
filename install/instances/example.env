# An example instance: copy this file (and example.seed.yaml) to instances/<name>.env, keep it with
# your instance, not here, and change every value. The Johnopia trial's own files are an instance's,
# kept outside the product (instances/johnopia/ in ffwf's platform repo).
INSTANCE=example
BRAND=Example
CLUSTER=c-example
ZONE=example.com
FORGE_HOST=forge.example.com
ADMIN_USER=ex-admin
PLATFORM_REPO=example/cicd-platform
COMPLIANCE_REPO=example/cicd-compliance
IAC_ORG=example-iac
TENANT=shop
BOT_USER=delivery-bot
CLUSTER_ISSUER=lab-ca
NODE_CIDR=172.17.0.0/16
FORGE_SSH=ssh://git@forgejo-ssh.forgejo.svc.cluster.local:22
